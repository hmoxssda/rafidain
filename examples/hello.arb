استورد الرياضيات

متغير عدد = 10
إذا (عدد > 5) {
    اطبع("العدد أكبر من 5")
} وإلا {
    اطبع("العدد أصغر أو يساوي 5")
}

دالة جمع(a, b) {
    رجع a + b
}

اطبع(جمع(3, 4))

كرر (متغير i = 0; i < 5; i++) {
    اطبع(i)
}

كائن شخص {
    هذا.الاسم = "أحمد"
    هذا.العمر = 30
}

متغير فرد = شخص()
اطبع(فرد.الاسم)
